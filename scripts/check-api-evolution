  --manifest-path "$consumer_dir/Cargo.toml" --locked --offline
cargo +1.97.1 run \
  --manifest-path "$consumer_dir/Cargo.toml" --locked --offline

assert_non_exhaustive_match() {
  local toolchain="$1"
  local example="$2"
  local receipt_name="$3"
  local diagnostic_name="$4"
  local stderr_file="$receipt_dir/$example-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example "$example" --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo "$receipt_name unexpectedly allowed an exhaustive downstream match" >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq "error[E0004]: non-exhaustive patterns: \`_\` not covered" "$stderr_file"
  grep -Fq "\`$diagnostic_name\` is marked as non-exhaustive, so a wildcard \`_\` is necessary" \
    "$stderr_file"
}

assert_receive_only_variant() {
  local toolchain="$1"
  local example="$2"
  local variant="$3"
  local stderr_file="$receipt_dir/$example-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example "$example" --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo "Event::$variant unexpectedly allowed downstream construction" >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq 'error[E0639]: cannot create non-exhaustive variant using struct expression' \
    "$stderr_file"
  grep -Fq "Event::$variant" "$stderr_file"
}

assert_non_exhaustive_fields() {
  local toolchain="$1"
  local stderr_file="$receipt_dir/capacity-without-rest-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example capacity-without-rest --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo 'Error::Capacity unexpectedly allowed a closed field match' >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq 'error[E0638]: `..` required with variant marked as non-exhaustive' "$stderr_file"
}

assert_not_sync() {
  local toolchain="$1"
  local stderr_file="$receipt_dir/poll-is-not-sync-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example poll-is-not-sync --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo 'Poll unexpectedly implemented Sync' >&2
    exit 1
  fi

  local errors
  local sync_errors
  errors="$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")"
  sync_errors="$(grep -Ec '^error\[E0277\]:' "$stderr_file")"
  test "$sync_errors" -ge 1
  test "$errors" -eq "$sync_errors"
  grep -Fq 'cannot be shared between threads safely' "$stderr_file"
  grep -Fq 'within `zio::Poll`' "$stderr_file"
}

assert_must_use_values() {
  local toolchain="$1"
  local stderr_file="$receipt_dir/must-use-values-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example must-use-values --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo 'discarded must-use values unexpectedly compiled' >&2
    exit 1
  fi

  test "$(grep -Ec '^error: unused .* that must be used$' "$stderr_file")" -eq 4
  grep -Fq 'call build to create a poller' "$stderr_file"
  grep -Fq 'retain a registration handle for explicit early deletion' "$stderr_file"
  grep -Fq 'process delivered events, then inspect the recovery report' "$stderr_file"
  grep -Fq 'retain the waker to signal the poller' "$stderr_file"
}

assert_intentional_omissions() {
  local toolchain="$1"
  local stderr_file="$receipt_dir/intentional-omissions-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example intentional-omissions --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo 'deliberately omitted public API unexpectedly compiled' >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 10
  test "$(grep -Fc 'error[E0277]:' "$stderr_file")" -eq 5
  test "$(grep -Fc 'error[E0599]:' "$stderr_file")" -eq 3
  test "$(grep -Fc 'error[E0624]:' "$stderr_file")" -eq 2
  grep -Fq 'no method named `into_source`' "$stderr_file"
  grep -Fq 'method `is_one_shot` is private' "$stderr_file"
  grep -Fq 'method `get` is private' "$stderr_file"
  grep -Fq 'no method named `build_with_events`' "$stderr_file"
}

for toolchain in 1.88.0 1.97.1; do
  assert_non_exhaustive_match "$toolchain" error-without-wildcard Error zio::Error
  assert_non_exhaustive_match "$toolchain" operation-without-wildcard Operation Operation
  assert_non_exhaustive_match \
    "$toolchain" capacity-kind-without-wildcard CapacityKind CapacityKind
  assert_non_exhaustive_match \
    "$toolchain" capacity-reason-without-wildcard CapacityReason CapacityReason
  assert_non_exhaustive_match "$toolchain" mode-without-wildcard Mode Mode
  assert_non_exhaustive_fields "$toolchain"
  assert_receive_only_variant "$toolchain" construct-resource Resource
  assert_receive_only_variant "$toolchain" construct-wake Wake
  assert_not_sync "$toolchain"
  assert_must_use_values "$toolchain"
  assert_intentional_omissions "$toolchain"
done

