#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

if [[ "$#" -ne 2 ]]; then
  echo "usage: scripts/check-api-evolution <crate-dir> <evidence-dir>" >&2
  exit 2
fi

crate_dir="$(cd "$1" && pwd)"
evidence_dir="$2"
mkdir -p "$evidence_dir"
evidence_dir="$(cd "$evidence_dir" && pwd)"

version="$(
  cargo metadata \
    --manifest-path "$crate_dir/Cargo.toml" \
    --no-deps --format-version 1 --locked --offline \
    | jq -er '.packages[] | select(.name == "zio") | .version'
)"
contract_dir="$(mktemp -d "${TMPDIR:-/tmp}/zio-api-contract.XXXXXX")"
cleanup() {
  case "$contract_dir" in
    "${TMPDIR:-/tmp}"/zio-api-contract.*) rm -rf -- "$contract_dir" ;;
    *) echo "refusing to remove unexpected API contract path" >&2 ;;
  esac
}
trap cleanup EXIT

consumer_dir="$contract_dir/consumer"
receipt_dir="$contract_dir/receipts"
mkdir -p "$consumer_dir/src" "$consumer_dir/examples" "$receipt_dir"
printf '%s\n' \
  '[package]' \
  'name = "zio-api-contract"' \
  'version = "0.0.0"' \
  'edition = "2024"' \
  'rust-version = "1.88"' \
  '' \
  '[dependencies]' \
  "zio = { path = \"$crate_dir\", version = \"=$version\", default-features = false }" \
  > "$consumer_dir/Cargo.toml"

printf '%s\n' \
  'use zio::{ArmState, CapacityKind, CapacityReason, CommitStatus, DeleteError, DescriptorOwnership, Error, Event, Key, Mode, MutationError, Operation, Poll, RecoveryFailure, RecoveryOutcome, RegisterError, RegisterOwnedError, Registration, RegistrationId, RegistrationInfo, RegistrationState, Wait, WaitReport, Waker};' \
  '' \
  'fn main() {' \
  '    assert_eq!(classify_error(&Error::Invariant), 1);' \
  '    assert_eq!(u64::from(Key::from(9_u64)), 9);' \
  '    assert_eq!(Key::new(9).to_string(), "9");' \
  '    assert_eq!(classify_operation(Operation::Wait), 1);' \
  '    assert_eq!(Operation::Wait.to_string(), "wait");' \
  '    assert_eq!(CommitStatus::Unknown.to_string(), "unknown");' \
  '    let _ = Error::operation as fn(&Error) -> Option<Operation>;' \
  '    let _ = Error::commit as fn(&Error) -> Option<CommitStatus>;' \
  '    let _ = Error::registration_id as fn(&Error) -> Option<zio::RegistrationId>;' \
  '    let _ = Error::registration as fn(&Error) -> Option<Registration>;' \
  '    let _ = Error::waker_key_conflict as fn(&Error) -> Option<(Key, Key)>;' \
  '    let _ = Error::capacity_limit as fn(&Error) -> Option<usize>;' \
  '    let _ = Error::capacity_kind as fn(&Error) -> Option<CapacityKind>;' \
  '    let _ = Error::capacity_reason as fn(&Error) -> Option<CapacityReason>;' \
  '    let _ = Error::event_capacity_mismatch as fn(&Error) -> Option<(usize, usize)>;' \
  '    let _ = Error::io_error as fn(&Error) -> Option<&std::io::Error>;' \
  '    let _ = classify_event as fn(Event) -> u8;' \
  '    let _ = Event::is_resource as fn(Event) -> bool;' \
  '    let _ = Event::is_wake as fn(Event) -> bool;' \
  '    let _ = Event::is_readable as fn(Event) -> bool;' \
  '    let _ = Event::is_writable as fn(Event) -> bool;' \
  '    let _ = Event::is_read_closed as fn(Event) -> bool;' \
  '    let _ = Event::is_write_closed as fn(Event) -> bool;' \
  '    let _ = Event::is_error as fn(Event) -> bool;' \
  '    assert_eq!(classify_commit(CommitStatus::Unknown), 2);' \
  '    assert_eq!(classify_mode(Mode::OneShot), 1);' \
  '    let _ = Mode::is_one_shot as fn(Mode) -> bool;' \
  '    assert_eq!(classify_wait(Wait::Forever), 2);' \
  '    let _ = Wait::is_nonblocking as fn(Wait) -> bool;' \
  '    assert_eq!(classify_arm(ArmState::Disarmed), 1);' \
  '    assert_eq!(classify_state(RegistrationState::Uncertain), 2);' \
  '    assert_eq!(classify_ownership(DescriptorOwnership::Borrowed), 1);' \
  '    let _ = RegistrationState::is_registered as fn(RegistrationState) -> bool;' \
  '    let _ = RegistrationState::is_uncertain as fn(RegistrationState) -> bool;' \
  '    let _ = RegistrationState::arm as fn(RegistrationState) -> Option<ArmState>;' \
  '    let _ = RecoveryOutcome::registration as fn(&RecoveryOutcome) -> Registration;' \
  '    let _ = RecoveryFailure::len as fn(&RecoveryFailure) -> usize;' \
  '    let _ = RecoveryFailure::is_empty as fn(&RecoveryFailure) -> bool;' \
  '    assert_slice::<RecoveryFailure, RecoveryOutcome>();' \
  '    let _ = iterate_recovery as fn(&RecoveryFailure);' \
  '    let _ = WaitReport::is_complete as fn(&WaitReport) -> bool;' \
  '    let _ = WaitReport::into_result as fn(WaitReport) -> Result<(), RecoveryFailure>;' \
  '    let _ = RegisterError::registration as fn(&RegisterError) -> Option<Registration>;' \
  '    let _ = RegisterOwnedError::descriptor as fn(&RegisterOwnedError) -> Option<&std::os::fd::OwnedFd>;' \
  '    let _ = RegisterOwnedError::registration as fn(&RegisterOwnedError) -> Option<Registration>;' \
  '    let _ = classify_owned_register_error as fn(&RegisterOwnedError) -> u8;' \
  '    let _ = DeleteError::registration as fn(&DeleteError) -> Registration;' \
  '    assert_error_ref::<RegisterError>();' \
  '    assert_error_ref::<RegisterOwnedError>();' \
  '    assert_error_ref::<DeleteError>();' \
  '    assert_thread_error::<Error>();' \
  '    assert_thread_error::<MutationError>();' \
  '    assert_thread_error::<RegisterError>();' \
  '    assert_thread_error::<RegisterOwnedError>();' \
  '    assert_thread_error::<DeleteError>();' \
  '    assert_thread_error::<RecoveryFailure>();' \
  '    let _ = MutationError::into_parts as fn(MutationError) -> (Operation, CommitStatus, std::io::Error);' \
  '    assert_ordered::<Registration>();' \
  '    let _ = RegistrationId::get as fn(RegistrationId) -> u64;' \
  '    assert_from::<u64, RegistrationId>();' \
  '    assert_display::<RegistrationId>();' \
  '    assert_hash::<Event>();' \
  '    assert_hash::<Wait>();' \
  '    assert_from::<Wait, std::time::Duration>();' \
  '    assert_from::<Wait, Option<std::time::Duration>>();' \
  '    assert_display::<Key>();' \
  '    assert_display::<Operation>();' \
  '    assert_display::<CommitStatus>();' \
  '    assert_display::<CapacityKind>();' \
  '    assert_display::<CapacityReason>();' \
  '    assert_eq!(classify_capacity(CapacityKind::Event), 0);' \
  '    assert_eq!(classify_capacity_reason(CapacityReason::Zero), 0);' \
  '    assert_send::<Poll>();' \
  '    assert_send_sync::<Waker>();' \
  '    let _ = Waker::key as fn(&Waker) -> Key;' \
  '    let _ = Poll::waker_key as fn(&Poll) -> Option<Key>;' \
  '    let _ = Poll::rearm as fn(&mut Poll, &Registration) -> Result<(), Error>;' \
  '    let _ = Poll::register_owned as fn(&mut Poll, std::os::fd::OwnedFd, Key, zio::Interest, Mode) -> Result<Registration, RegisterOwnedError>;' \
  '    let _ = Poll::registration_fd as for<'\''poll, '\''registration> fn(&'\''poll Poll, &'\''registration Registration) -> Result<std::os::fd::BorrowedFd<'\''poll>, Error>;' \
  '    let _ = Poll::registrations as fn(&Poll) -> Result<Vec<Registration>, Error>;' \
  '    let _ = Poll::event_capacity as fn(&Poll) -> usize;' \
  '    let _ = Poll::registration_capacity as fn(&Poll) -> usize;' \
  '    let _ = Poll::registration_count as fn(&Poll) -> usize;' \
  '    let _ = Poll::remaining_registration_capacity as fn(&Poll) -> usize;' \
  '    let _ = Poll::registration_info as fn(&Poll, &Registration) -> Result<RegistrationInfo, Error>;' \
  '    let _ = Poll::set_key as fn(&mut Poll, &Registration, Key) -> Result<(), Error>;' \
  '    let _ = RegistrationInfo::key as fn(&RegistrationInfo) -> Key;' \
  '    let _ = RegistrationInfo::interest as fn(&RegistrationInfo) -> zio::Interest;' \
  '    let _ = RegistrationInfo::mode as fn(&RegistrationInfo) -> Mode;' \
  '    let _ = RegistrationInfo::state as fn(&RegistrationInfo) -> RegistrationState;' \
  '    let _ = RegistrationInfo::descriptor_ownership as fn(&RegistrationInfo) -> DescriptorOwnership;' \
  '    let mut interest = zio::Interest::READABLE;' \
  '    let _ = zio::Interest::ALL;' \
  '    let _ = interest.symmetric_difference(zio::Interest::ALL);' \
  '    let _ = interest.complement();' \
  '    let _ = !interest;' \
  '    interest |= zio::Interest::WRITABLE;' \
  '    interest &= zio::Interest::WRITABLE;' \
  '    interest ^= zio::Interest::READABLE;' \
  '    interest -= zio::Interest::WRITABLE;' \
  '    let _ = interest;' \
  '    let mut readiness = zio::Readiness::READABLE | zio::Readiness::READ_CLOSED;' \
  '    let _ = zio::Readiness::ALL;' \
  '    let _ = readiness.symmetric_difference(zio::Readiness::ALL);' \
  '    let _ = readiness.complement();' \
  '    let _ = !readiness;' \
  '    let _ = readiness.intersects(zio::Readiness::READABLE);' \
  '    readiness |= zio::Readiness::ERROR;' \
  '    readiness &= zio::Readiness::READ_CLOSED | zio::Readiness::ERROR;' \
  '    readiness ^= zio::Readiness::READABLE;' \
  '    readiness -= zio::Readiness::ERROR;' \
  '    let _ = readiness;' \
  '    let _ = reverse_events as fn(&mut zio::Events);' \
  '    let _ = consume_events as fn(zio::Events);' \
  '}' \
  '' \
  'fn assert_ordered<T: Ord>() {}' \
  '' \
  'fn assert_hash<T: std::hash::Hash>() {}' \
  '' \
  'fn assert_display<T: std::fmt::Display>() {}' \
  '' \
  'fn assert_from<T: From<U>, U>() {}' \
  '' \
  'fn assert_slice<T: AsRef<[U]>, U>() {}' \
  '' \
  'fn assert_error_ref<T: AsRef<Error>>() {}' \
  '' \
  "fn assert_thread_error<T: std::error::Error + Send + Sync + 'static>() {}" \
  '' \
  'fn assert_send<T: Send>() {}' \
  '' \
  'fn assert_send_sync<T: Send + Sync>() {}' \
  '' \
  'fn reverse_events(events: &mut zio::Events) {' \
  '    let _ = events.iter().rev();' \
  '    let _ = events.drain().rev();' \
  '}' \
  '' \
  'fn consume_events(events: zio::Events) {' \
  '    let _ = events.into_iter().rev();' \
  '}' \
  '' \
  'fn iterate_recovery(failure: &RecoveryFailure) {' \
  '    let _: Option<&RecoveryOutcome> = failure.iter().next();' \
  '    let _: Option<&RecoveryOutcome> = failure.into_iter().next();' \
  '}' \
  '' \
  'fn classify_error(error: &Error) -> u8 {' \
  '    match error {' \
  '        Error::Invariant => 1,' \
  '        _ => 0,' \
  '    }' \
  '}' \
  '' \
  'fn classify_owned_register_error(error: &RegisterOwnedError) -> u8 {' \
  '    match error {' \
  '        RegisterOwnedError::Returned { .. } => 0,' \
  '        RegisterOwnedError::Retained { .. } => 1,' \
  '    }' \
  '}' \
  '' \
  'fn classify_capacity(kind: CapacityKind) -> u8 {' \
  '    match kind {' \
  '        CapacityKind::Event => 0,' \
  '        CapacityKind::Registration => 1,' \
  '        _ => 2,' \
  '    }' \
  '}' \
  '' \
  'fn classify_capacity_reason(reason: CapacityReason) -> u8 {' \
  '    match reason {' \
  '        CapacityReason::Zero => 0,' \
  '        CapacityReason::Exhausted => 1,' \
  '        CapacityReason::StorageUnavailable => 2,' \
  '        _ => 3,' \
  '    }' \
  '}' \
  '' \
  'fn classify_operation(operation: Operation) -> u8 {' \
  '    match operation {' \
  '        Operation::Wait => 1,' \
  '        _ => 0,' \
  '    }' \
  '}' \
  '' \
  'fn classify_event(event: Event) -> u8 {' \
  '    match event {' \
  '        Event::Resource { .. } => 0,' \
  '        Event::Wake { .. } => 1,' \
  '    }' \
  '}' \
  '' \
  'fn classify_commit(commit: CommitStatus) -> u8 {' \
  '    match commit {' \
  '        CommitStatus::NotApplied => 0,' \
  '        CommitStatus::Applied => 1,' \
  '        CommitStatus::Unknown => 2,' \
  '    }' \
  '}' \
  '' \
  'fn classify_mode(mode: Mode) -> u8 {' \
  '    match mode {' \
  '        Mode::Level => 0,' \
  '        Mode::OneShot => 1,' \
  '    }' \
  '}' \
  '' \
  'fn classify_wait(wait: Wait) -> u8 {' \
  '    match wait {' \
  '        Wait::NoBlock => 0,' \
  '        Wait::For(_) => 1,' \
  '        Wait::Forever => 2,' \
  '    }' \
  '}' \
  '' \
  'fn classify_arm(arm: ArmState) -> u8 {' \
  '    match arm {' \
  '        ArmState::Armed => 0,' \
  '        ArmState::Disarmed => 1,' \
  '    }' \
  '}' \
  '' \
  'fn classify_state(state: RegistrationState) -> u8 {' \
  '    match state {' \
  '        RegistrationState::Registered { arm } => classify_arm(arm),' \
  '        RegistrationState::Uncertain => 2,' \
  '    }' \
  '}' \
  '' \
  'fn classify_ownership(ownership: DescriptorOwnership) -> u8 {' \
  '    match ownership {' \
  '        DescriptorOwnership::Owned => 0,' \
  '        DescriptorOwnership::Borrowed => 1,' \
  '    }' \
  '}' \
  > "$consumer_dir/src/main.rs"

printf '%s\n' \
  'use zio::Error;' \
  '' \
  'fn main() {' \
  '    let _ = classify(Error::Invariant);' \
  '}' \
  '' \
  'fn classify(error: Error) -> u8 {' \
  '    match error {' \
  '        Error::Io { .. } => 0,' \
  '        Error::Mutation(_) => 1,' \
  '        Error::WakerAlreadyConfigured { .. } => 2,' \
  '        Error::WrongPoller { .. } => 3,' \
  '        Error::InvalidInterest => 4,' \
  '        Error::Stale { .. } => 5,' \
  '        Error::Uncertain { .. } => 6,' \
  '        Error::Capacity { .. } => 7,' \
  '        Error::RegistrationSpaceExhausted => 8,' \
  '        Error::EventsTooSmall { .. } => 9,' \
  '        Error::Invariant => 10,' \
  '        Error::UnsupportedPlatform => 11,' \
  '    }' \
  '}' \
  > "$consumer_dir/examples/error-without-wildcard.rs"

printf '%s\n' \
  'use zio::Operation;' \
  '' \
  'fn main() {' \
  '    let _ = classify(Operation::Wait);' \
  '}' \
  '' \
  'fn classify(operation: Operation) -> u8 {' \
  '    match operation {' \
  '        Operation::CreatePoller => 0,' \
  '        Operation::CreateWaker => 1,' \
  '        Operation::RegisterWaker => 2,' \
  '        Operation::Register => 3,' \
  '        Operation::Modify => 4,' \
  '        Operation::Delete => 5,' \
  '        Operation::Wait => 6,' \
  '        Operation::TriggerWake => 7,' \
  '        Operation::Disarm => 8,' \
  '        Operation::UnsupportedPlatform => 9,' \
  '    }' \
  '}' \
  > "$consumer_dir/examples/operation-without-wildcard.rs"

printf '%s\n' \
  'use zio::CapacityKind;' \
  '' \
  'fn main() {' \
  '    let _ = classify(CapacityKind::Event);' \
  '}' \
  '' \
  'fn classify(kind: CapacityKind) -> u8 {' \
  '    match kind {' \
  '        CapacityKind::Event => 0,' \
  '        CapacityKind::Registration => 1,' \
  '    }' \
  '}' \
  > "$consumer_dir/examples/capacity-kind-without-wildcard.rs"

printf '%s\n' \
  'use zio::CapacityReason;' \
  '' \
  'fn main() {' \
  '    let _ = classify(CapacityReason::Zero);' \
  '}' \
  '' \
  'fn classify(reason: CapacityReason) -> u8 {' \
  '    match reason {' \
  '        CapacityReason::Zero => 0,' \
  '        CapacityReason::Exhausted => 1,' \
  '        CapacityReason::StorageUnavailable => 2,' \
  '    }' \
  '}' \
  > "$consumer_dir/examples/capacity-reason-without-wildcard.rs"

printf '%s\n' \
  'use zio::Error;' \
  '' \
  'fn main() {' \
  '    let _ = capacity as fn(&Error) -> Option<usize>;' \
  '}' \
  '' \
  'fn capacity(error: &Error) -> Option<usize> {' \
  '    match error {' \
  '        Error::Capacity { kind: _, limit, reason: _ } => Some(*limit),' \
  '        _ => None,' \
  '    }' \
  '}' \
  > "$consumer_dir/examples/capacity-without-rest.rs"

printf '%s\n' \
  'use zio::{Event, Key};' \
  '' \
  'fn main() {' \
  '    let _ = Event::Wake { key: Key::ZERO };' \
  '}' \
  > "$consumer_dir/examples/construct-wake.rs"

printf '%s\n' \
  'use zio::{Event, Key, Readiness, Registration};' \
  '' \
  'fn main() {' \
  '    let _ = construct as fn(Registration) -> Event;' \
  '}' \
  '' \
  'fn construct(registration: Registration) -> Event {' \
  '    Event::Resource { registration, key: Key::ZERO, readiness: Readiness::EMPTY }' \
  '}' \
  > "$consumer_dir/examples/construct-resource.rs"

cargo +1.88.0 generate-lockfile \
  --manifest-path "$consumer_dir/Cargo.toml" --offline
cargo +1.88.0 run \
  --manifest-path "$consumer_dir/Cargo.toml" --locked --offline
cargo +1.97.1 run \
  --manifest-path "$consumer_dir/Cargo.toml" --locked --offline

assert_non_exhaustive_match() {
  local toolchain="$1"
  local example="$2"
  local receipt_name="$3"
  local diagnostic_name="$4"
  local stderr_file="$receipt_dir/$example-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example "$example" --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo "$receipt_name unexpectedly allowed an exhaustive downstream match" >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq "error[E0004]: non-exhaustive patterns: \`_\` not covered" "$stderr_file"
  grep -Fq "\`$diagnostic_name\` is marked as non-exhaustive, so a wildcard \`_\` is necessary" \
    "$stderr_file"
}

assert_receive_only_variant() {
  local toolchain="$1"
  local example="$2"
  local variant="$3"
  local stderr_file="$receipt_dir/$example-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example "$example" --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo "Event::$variant unexpectedly allowed downstream construction" >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq 'error[E0639]: cannot create non-exhaustive variant using struct expression' \
    "$stderr_file"
  grep -Fq "Event::$variant" "$stderr_file"
}

assert_non_exhaustive_fields() {
  local toolchain="$1"
  local stderr_file="$receipt_dir/capacity-without-rest-$toolchain.stderr"

  if CARGO_TERM_COLOR=never cargo "+$toolchain" check \
    --manifest-path "$consumer_dir/Cargo.toml" \
    --example capacity-without-rest --locked --offline \
    > /dev/null 2> "$stderr_file"; then
    echo 'Error::Capacity unexpectedly allowed a closed field match' >&2
    exit 1
  fi

  test "$(grep -Ec '^error\[E[0-9]+\]:' "$stderr_file")" -eq 1
  grep -Fq 'error[E0638]: `..` required with variant marked as non-exhaustive' "$stderr_file"
}

for toolchain in 1.88.0 1.97.1; do
  assert_non_exhaustive_match "$toolchain" error-without-wildcard Error zio::Error
  assert_non_exhaustive_match "$toolchain" operation-without-wildcard Operation Operation
  assert_non_exhaustive_match \
    "$toolchain" capacity-kind-without-wildcard CapacityKind CapacityKind
  assert_non_exhaustive_match \
    "$toolchain" capacity-reason-without-wildcard CapacityReason CapacityReason
  assert_non_exhaustive_fields "$toolchain"
  assert_receive_only_variant "$toolchain" construct-resource Resource
  assert_receive_only_variant "$toolchain" construct-wake Wake
done

for receipt in "$receipt_dir"/*.stderr; do
  cp "$receipt" "$evidence_dir/"
done

error_msrv_sha256="$(shasum -a 256 "$receipt_dir/error-without-wildcard-1.88.0.stderr" | awk '{print $1}')"
error_current_sha256="$(shasum -a 256 "$receipt_dir/error-without-wildcard-1.97.1.stderr" | awk '{print $1}')"
operation_msrv_sha256="$(shasum -a 256 "$receipt_dir/operation-without-wildcard-1.88.0.stderr" | awk '{print $1}')"
operation_current_sha256="$(shasum -a 256 "$receipt_dir/operation-without-wildcard-1.97.1.stderr" | awk '{print $1}')"
capacity_kind_msrv_sha256="$(shasum -a 256 "$receipt_dir/capacity-kind-without-wildcard-1.88.0.stderr" | awk '{print $1}')"
capacity_kind_current_sha256="$(shasum -a 256 "$receipt_dir/capacity-kind-without-wildcard-1.97.1.stderr" | awk '{print $1}')"
capacity_reason_msrv_sha256="$(shasum -a 256 "$receipt_dir/capacity-reason-without-wildcard-1.88.0.stderr" | awk '{print $1}')"
capacity_reason_current_sha256="$(shasum -a 256 "$receipt_dir/capacity-reason-without-wildcard-1.97.1.stderr" | awk '{print $1}')"
capacity_msrv_sha256="$(shasum -a 256 "$receipt_dir/capacity-without-rest-1.88.0.stderr" | awk '{print $1}')"
capacity_current_sha256="$(shasum -a 256 "$receipt_dir/capacity-without-rest-1.97.1.stderr" | awk '{print $1}')"
resource_msrv_sha256="$(shasum -a 256 "$receipt_dir/construct-resource-1.88.0.stderr" | awk '{print $1}')"
resource_current_sha256="$(shasum -a 256 "$receipt_dir/construct-resource-1.97.1.stderr" | awk '{print $1}')"
wake_msrv_sha256="$(shasum -a 256 "$receipt_dir/construct-wake-1.88.0.stderr" | awk '{print $1}')"
wake_current_sha256="$(shasum -a 256 "$receipt_dir/construct-wake-1.97.1.stderr" | awk '{print $1}')"
jq -n \
  --arg version "$version" \
  --arg error_msrv_sha256 "$error_msrv_sha256" \
  --arg error_current_sha256 "$error_current_sha256" \
  --arg operation_msrv_sha256 "$operation_msrv_sha256" \
  --arg operation_current_sha256 "$operation_current_sha256" \
  --arg capacity_kind_msrv_sha256 "$capacity_kind_msrv_sha256" \
  --arg capacity_kind_current_sha256 "$capacity_kind_current_sha256" \
  --arg capacity_reason_msrv_sha256 "$capacity_reason_msrv_sha256" \
  --arg capacity_reason_current_sha256 "$capacity_reason_current_sha256" \
  --arg capacity_msrv_sha256 "$capacity_msrv_sha256" \
  --arg capacity_current_sha256 "$capacity_current_sha256" \
  --arg resource_msrv_sha256 "$resource_msrv_sha256" \
  --arg resource_current_sha256 "$resource_current_sha256" \
  --arg wake_msrv_sha256 "$wake_msrv_sha256" \
  --arg wake_current_sha256 "$wake_current_sha256" \
  '{schema:"zio.public-api-contract.v1", status:"passed", version:$version, toolchains:["1.88.0","1.97.1"], open_enums:["Error","Operation","CapacityKind","CapacityReason"], closed_enums:["Event","CommitStatus","DescriptorOwnership","Mode","Wait","ArmState","RegistrationState"], field_extensible_variants:["Error::Capacity"], receive_only_variants:["Event::Resource","Event::Wake"], diagnostics:{error_msrv:$error_msrv_sha256,error_current:$error_current_sha256,operation_msrv:$operation_msrv_sha256,operation_current:$operation_current_sha256,capacity_kind_msrv:$capacity_kind_msrv_sha256,capacity_kind_current:$capacity_kind_current_sha256,capacity_reason_msrv:$capacity_reason_msrv_sha256,capacity_reason_current:$capacity_reason_current_sha256,capacity_msrv:$capacity_msrv_sha256,capacity_current:$capacity_current_sha256,resource_msrv:$resource_msrv_sha256,resource_current:$resource_current_sha256,wake_msrv:$wake_msrv_sha256,wake_current:$wake_current_sha256}}' \
  > "$evidence_dir/public-api-contract.json"

printf 'API evolution contract passed: zio %s\n' "$version"
