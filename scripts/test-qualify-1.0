#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
catalog="$repository_root/crates/zio-qualify/perf-catalog.json"
gate="$repository_root/scripts/qualify-1.0"
record_performance="$repository_root/scripts/record-performance-qualification"
commit='0123456789abcdef0123456789abcdef01234567'
other_commit='abcdef0123456789abcdef0123456789abcdef01'
version='1.0.0-rc.1'
run_id='987654321'
run_attempt='1'
scratch="$(mktemp -d "${TMPDIR:-/tmp}/zio-1.0-test.XXXXXX")"

cleanup() {
  case "$scratch" in
    "${TMPDIR:-/tmp}"/zio-1.0-test.*) rm -rf -- "$scratch" ;;
    *) printf 'refusing to remove unexpected test path\n' >&2 ;;
  esac
}
trap cleanup EXIT

write_skew() {
  local output="$1"
  local os="$2"
  local recorded="$3"
  local run_id="$4"
  : > "$output"
  while read -r registrations capacity ready label; do
    local waits=$(((ready + capacity - 1) / capacity))
    local level_events=$((waits * capacity))
    local required=$((registrations + 8))
    jq -cn \
      --arg commit "$commit" --arg version "$version" --arg os "$os" --arg label "$label" \
      --arg run_id "$run_id" \
      --argjson recorded "$recorded" --argjson registrations "$registrations" \
      --argjson capacity "$capacity" --argjson ready "$ready" --argjson waits "$waits" \
      --argjson level_events "$level_events" --argjson required "$required" '
      {
        schema: "zio.kqueue-skew.v1",
        zio_version: $version,
        status: "passed",
        run_id: $run_id,
        git: {sha: $commit, sha_source: "fixture", dirty: false},
        host: {
          os: $os,
          os_version: ($os + " fixture"),
          arch: "fixture-arch",
          cpu: "fixture-cpu",
          rustc: "rustc fixture",
          build_profile: "release",
          rustflags: "fixture"
        },
        recorded_unix_ms: $recorded,
        parameters: {
          registrations: $registrations,
          event_capacity: $capacity,
          ready_registrations: $ready,
          ready_fraction: $label
        },
        resource_limit: {
          open_fds: 11,
          soft_fd_limit: 2000000,
          fd_limit_source: "fixture",
          required_additional_fds: $required
        },
        level: {
          elapsed_ns: ($level_events * 10),
          waits_to_complete_cycle: $waits,
          raw_native_events_returned: $level_events,
          logical_events_delivered: $level_events,
          unique_registrations_delivered: $ready,
          ns_per_logical_event: 10,
          disarm_submissions: 0,
          disarmed_registrations: 0,
          disarm_submission_elapsed_ns: 0,
          disarm_ns_per_registration: 0,
          retained_heap: {
            allocation_count_current: 3,
            bytes_current: ($registrations * 64),
            bytes_peak: ($registrations * 64)
          }
        },
        one_shot: {
          elapsed_ns: ($ready * 10),
          waits_to_complete_cycle: $waits,
          raw_native_events_returned: $ready,
          logical_events_delivered: $ready,
          unique_registrations_delivered: $ready,
          ns_per_logical_event: 10,
          disarm_submissions: $waits,
          disarmed_registrations: $ready,
          disarm_submission_elapsed_ns: $ready,
          disarm_ns_per_registration: 1,
          retained_heap: {
            allocation_count_current: 3,
            bytes_current: ($registrations * 64),
            bytes_peak: ($registrations * 64)
          }
        }
      }
    ' >> "$output"
  done <<'ROWS'
100000 64 100 0.1_percent
100000 256 1000 1_percent
100000 256 50000 50_percent
100000 1024 100000 100_percent
1000000 1024 1024 sparse_1024
ROWS
}

write_performance_source() {
  local output="$1"
  local os="$2"
  local metric="$3"
  local replica="$4"
  local samples
  samples="$(jq -er --arg metric "$metric" '.samples[$metric]' "$catalog")"
  local os_offset=0
  [[ "$os" == 'linux' ]] || os_offset=1000
  local metric_offset=1
  [[ "$metric" == 'timing' ]] || metric_offset=2
  local recorded=$((1700000000000 + os_offset + replica * 10 + metric_offset))
  jq -cn \
    --slurpfile catalog "$catalog" \
    --arg commit "$commit" --arg version "$version" --arg os "$os" \
    --arg metric "$metric" --argjson samples "$samples" --argjson recorded "$recorded" '
    def expected_pairs($catalog):
      [
        $catalog.candidates[] as $candidate |
        $catalog.scenarios[] as $scenario |
        [$candidate, $scenario] |
        select(. as $pair | (any($catalog.excluded_pairs[]; . == $pair) | not))
      ];
    def candidate_version($candidate):
      if $candidate == "zio" or $candidate == "zio-borrowed" then $version
      elif $candidate == "mio" then "1.2.2"
      else "3.11.0"
      end;
    expected_pairs($catalog[0])[] as $pair |
    {
      schema: "zio.perf.v2",
      kind: "measurement",
      metric: $metric,
      status: "passed",
      git: {sha: $commit, source: "fixture", dirty: false},
      host: {
        os: $os,
        os_version: ($os + " fixture"),
        arch: "fixture-arch",
        cpu: "fixture-cpu",
        recorded_unix_ms: $recorded
      },
      toolchain: {
        rustc: "rustc fixture",
        rustflags: "fixture",
        build_profile: "release"
      },
      candidate: {name: $pair[0], version: candidate_version($pair[0])},
      harness: {crate: "zio-qualify", version: $version},
      comparison_set: {
        zio: $version,
        zio_borrowed: $version,
        mio: "1.2.2",
        polling: "3.11.0"
      },
      scenario: {name: $pair[1]},
      parameters: {samples: $samples, iterations: 1, warmup_iterations: 1},
      raw: (
        {
          round: [range(0; $samples)],
          order_position: [range(0; $samples) | . % 4],
          operations: [range(0; $samples) | 1],
          events: [range(0; $samples) | 0]
        } +
        if $metric == "timing" then {
          measured_elapsed_ns: [range(0; $samples) | 100],
          sample_mean_ns_per_operation: [range(0; $samples) | 100]
        } else {
          allocation_count_total: [range(0; $samples) | 0],
          allocation_count_peak: [range(0; $samples) | 0],
          allocation_bytes_total: [range(0; $samples) | 0],
          allocation_bytes_peak: [range(0; $samples) | 0],
          allocation_count_current: [range(0; $samples) | 0],
          allocation_bytes_current: [range(0; $samples) | 0]
        } end
      )
    }
  ' > "$output"
}

record_summary() {
  local directory="$1"
  local os="$2"
  local replica="$3"
  GITHUB_RUN_ID="$run_id" \
    GITHUB_RUN_ATTEMPT="$run_attempt" \
    GITHUB_JOB='measure' \
    "$record_performance" \
    "$commit" "$os" "$replica" \
    "$directory/timing.ndjson" "$directory/allocation.ndjson" \
    "$directory/qualification-receipt.json"
}

write_performance() {
  local root="$1"
  mkdir -p "$root"
  for os in linux macos; do
    for replica in 1 2 3 4 5; do
      local directory="$root/$os-$replica"
      mkdir -p "$directory"
      write_performance_source "$directory/timing.ndjson" "$os" timing "$replica"
      write_performance_source "$directory/allocation.ndjson" "$os" allocation "$replica"
      record_summary "$directory" "$os" "$replica"
    done
  done
}

write_release() {
  local output="$1"
  jq -n --arg commit "$commit" --arg version "$version" '
    {
      schema: "zio.release-rehearsal.v1",
      status: "passed",
      commit: $commit,
      git: {sha: $commit, dirty: false},
      version: $version,
      archive_sha256: ("a" * 64)
    }
  ' > "$output"
}

run_gate() {
  "$gate" \
    --commit "$commit" \
    --macos-receipts "$1" \
    --bsd-receipts "$2" \
    --performance-receipts "$3" \
    --release-rehearsal-receipt "$4"
}

expect_failure() {
  local name="$1"
  shift
  if "$@" > "$scratch/$name.stdout" 2> "$scratch/$name.stderr"; then
    printf 'expected %s evidence to be rejected\n' "$name" >&2
    return 1
  fi
}

expect_record_failure() {
  local name="$1"
  local directory="$2"
  expect_failure "$name" env \
    GITHUB_RUN_ID="$run_id" GITHUB_RUN_ATTEMPT="$run_attempt" GITHUB_JOB=measure \
    "$record_performance" "$commit" linux 1 \
    "$directory/timing.ndjson" "$directory/allocation.ndjson" \
    "$directory/rejected-summary.json"
}

performance_case() {
  local name="$1"
  local directory="$scratch/performance-case-$name"
  mkdir -p "$directory"
  cp "$performance/linux-1/timing.ndjson" "$directory/timing.ndjson"
  cp "$performance/linux-1/allocation.ndjson" "$directory/allocation.ndjson"
  printf '%s\n' "$directory"
}

macos="$scratch/macos.ndjson"
bsd="$scratch/freebsd.ndjson"
performance="$scratch/performance"
release="$scratch/release.json"
write_skew "$macos" macos 1700000000001 '11111111-1111-4111-8111-111111111111'
write_skew "$bsd" freebsd 1700000000002 '22222222-2222-4222-8222-222222222222'
write_performance "$performance"
write_release "$release"
run_gate "$macos" "$bsd" "$performance" "$release" > "$scratch/success.stdout"

known="$(performance_case known-unsupported)"
for metric in timing allocation; do
  jq -c '
    if .candidate.name == "polling" and
      .scenario.name == "wait.ready.readable.level.repeat"
    then .status = "unsupported" |
      .reason_code = "capability_unavailable" |
      .reason = "fixture host has no native level support"
    else . end
  ' "$known/$metric.ndjson" > "$known/$metric.changed"
  mv "$known/$metric.changed" "$known/$metric.ndjson"
done
record_summary "$known" linux 1

invented_candidate="$(performance_case invented-candidate)"
for metric in timing allocation; do
  jq -c 'if input_line_number == 1 then .candidate.name = "invented" else . end' \
    "$invented_candidate/$metric.ndjson" > "$invented_candidate/$metric.changed"
  mv "$invented_candidate/$metric.changed" "$invented_candidate/$metric.ndjson"
done
expect_record_failure invented-candidate "$invented_candidate"

invented_scenario="$(performance_case invented-scenario)"
for metric in timing allocation; do
  jq -c 'if input_line_number == 1 then .scenario.name = "invented" else . end' \
    "$invented_scenario/$metric.ndjson" > "$invented_scenario/$metric.changed"
  mv "$invented_scenario/$metric.changed" "$invented_scenario/$metric.ndjson"
done
expect_record_failure invented-scenario "$invented_scenario"

mismatched_pairs="$(performance_case mismatched-pairs)"
jq -c 'if input_line_number == 1 then .scenario.name = "wait.empty.no_block" else . end' \
  "$mismatched_pairs/allocation.ndjson" > "$mismatched_pairs/allocation.changed"
mv "$mismatched_pairs/allocation.changed" "$mismatched_pairs/allocation.ndjson"
expect_record_failure mismatched-pairs "$mismatched_pairs"

mismatched_outcome="$(performance_case mismatched-outcome)"
jq -c '
  if .candidate.name == "polling" and
    .scenario.name == "wait.ready.readable.level.repeat"
  then .status = "unsupported" |
    .reason_code = "capability_unavailable" |
    .reason = "fixture host has no native level support"
  else . end
' "$mismatched_outcome/timing.ndjson" > "$mismatched_outcome/timing.changed"
mv "$mismatched_outcome/timing.changed" "$mismatched_outcome/timing.ndjson"
expect_record_failure mismatched-outcome "$mismatched_outcome"

all_unsupported="$(performance_case all-unsupported)"
for metric in timing allocation; do
  jq -c '.status = "unsupported" | .reason_code = "capability_unavailable" | .reason = "fixture"' \
    "$all_unsupported/$metric.ndjson" > "$all_unsupported/$metric.changed"
  mv "$all_unsupported/$metric.changed" "$all_unsupported/$metric.ndjson"
done
expect_record_failure all-unsupported "$all_unsupported"

wrong_samples="$(performance_case wrong-samples)"
jq -c 'if input_line_number == 1 then .parameters.samples = 95 else . end' \
  "$wrong_samples/timing.ndjson" > "$wrong_samples/timing.changed"
mv "$wrong_samples/timing.changed" "$wrong_samples/timing.ndjson"
expect_record_failure wrong-samples "$wrong_samples"

debug_build="$(performance_case debug-build)"
for metric in timing allocation; do
  jq -c '.toolchain.build_profile = "debug"' \
    "$debug_build/$metric.ndjson" > "$debug_build/$metric.changed"
  mv "$debug_build/$metric.changed" "$debug_build/$metric.ndjson"
done
expect_record_failure debug-build "$debug_build"

sed '$d' "$macos" > "$scratch/missing-row.ndjson"
expect_failure missing-row run_gate \
  "$scratch/missing-row.ndjson" "$bsd" "$performance" "$release"

{
  sed -n '1,4p' "$macos"
  sed -n '1p' "$macos"
} > "$scratch/duplicate-row.ndjson"
expect_failure duplicate-row run_gate \
  "$scratch/duplicate-row.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .status = "unsupported" else . end' \
  "$bsd" > "$scratch/unsupported-row.ndjson"
expect_failure unsupported-row run_gate \
  "$macos" "$scratch/unsupported-row.ndjson" "$performance" "$release"

jq -c --arg commit "$other_commit" '.git.sha = $commit' \
  "$macos" > "$scratch/wrong-sha.ndjson"
expect_failure wrong-sha run_gate \
  "$scratch/wrong-sha.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .git.dirty = true else . end' \
  "$macos" > "$scratch/dirty-row.ndjson"
expect_failure dirty-row run_gate \
  "$scratch/dirty-row.ndjson" "$bsd" "$performance" "$release"

types=(string array object null negative fractional)
values=('"garbage"' '[]' '{}' 'null' '-1' '1.5')
for index in "${!types[@]}"; do
  name="metric-${types[$index]}"
  output="$scratch/$name.ndjson"
  jq -c --argjson value "${values[$index]}" \
    'if input_line_number == 1 then .level.raw_native_events_returned = $value else . end' \
    "$macos" > "$output"
  expect_failure "$name" run_gate "$output" "$bsd" "$performance" "$release"
done

jq -c 'if input_line_number == 1 then .one_shot.retained_heap.bytes_current = "garbage" else . end' \
  "$macos" > "$scratch/string-memory.ndjson"
expect_failure string-memory run_gate \
  "$scratch/string-memory.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .recorded_unix_ms = "garbage" else . end' \
  "$macos" > "$scratch/string-timestamp.ndjson"
expect_failure string-timestamp run_gate \
  "$scratch/string-timestamp.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .run_id = "garbage" else . end' \
  "$macos" > "$scratch/invalid-run-id.ndjson"
expect_failure invalid-run-id run_gate \
  "$scratch/invalid-run-id.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .parameters.registrations = "garbage" else . end' \
  "$macos" > "$scratch/string-registrations.ndjson"
expect_failure string-registrations run_gate \
  "$scratch/string-registrations.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .parameters.event_capacity = null else . end' \
  "$macos" > "$scratch/null-event-capacity.ndjson"
expect_failure null-event-capacity run_gate \
  "$scratch/null-event-capacity.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .parameters.ready_registrations = 1.5 else . end' \
  "$macos" > "$scratch/fractional-ready.ndjson"
expect_failure fractional-ready run_gate \
  "$scratch/fractional-ready.ndjson" "$bsd" "$performance" "$release"

jq -c 'if input_line_number == 1 then .level.waits_to_complete_cycle = [] else . end' \
  "$macos" > "$scratch/array-waits.ndjson"
expect_failure array-waits run_gate \
  "$scratch/array-waits.ndjson" "$bsd" "$performance" "$release"

jq -c --arg run_id '11111111-1111-4111-8111-111111111111' '.run_id = $run_id' \
  "$bsd" > "$scratch/reused-kqueue-run.ndjson"
expect_failure reused-kqueue-run run_gate \
  "$macos" "$scratch/reused-kqueue-run.ndjson" "$performance" "$release"

cp -R "$performance" "$scratch/missing-performance"
rm "$scratch/missing-performance/linux-5/qualification-receipt.json"
expect_failure missing-performance run_gate \
  "$macos" "$bsd" "$scratch/missing-performance" "$release"

cp -R "$performance" "$scratch/duplicate-performance"
cp -R "$scratch/duplicate-performance/linux-1" \
  "$scratch/duplicate-performance/linux-1-copy"
expect_failure duplicate-performance run_gate \
  "$macos" "$bsd" "$scratch/duplicate-performance" "$release"

cp -R "$performance" "$scratch/reused-performance"
cp "$scratch/reused-performance/linux-1/timing.ndjson" \
  "$scratch/reused-performance/linux-2/timing.ndjson"
cp "$scratch/reused-performance/linux-1/allocation.ndjson" \
  "$scratch/reused-performance/linux-2/allocation.ndjson"
record_summary "$scratch/reused-performance/linux-2" linux 2
expect_failure reused-performance run_gate \
  "$macos" "$bsd" "$scratch/reused-performance" "$release"

cp -R "$performance" "$scratch/tampered-performance"
jq -c 'if input_line_number == 1 then .raw.operations[0] = 2 else . end' \
  "$scratch/tampered-performance/linux-1/timing.ndjson" \
  > "$scratch/tampered-performance/linux-1/timing.changed"
mv "$scratch/tampered-performance/linux-1/timing.changed" \
  "$scratch/tampered-performance/linux-1/timing.ndjson"
expect_failure tampered-performance run_gate \
  "$macos" "$bsd" "$scratch/tampered-performance" "$release"

cp -R "$performance" "$scratch/mixed-run-performance"
jq '.github.run_id = "123456789"' \
  "$scratch/mixed-run-performance/linux-1/qualification-receipt.json" \
  > "$scratch/mixed-run-performance/linux-1/qualification.changed"
mv "$scratch/mixed-run-performance/linux-1/qualification.changed" \
  "$scratch/mixed-run-performance/linux-1/qualification-receipt.json"
expect_failure mixed-run-performance run_gate \
  "$macos" "$bsd" "$scratch/mixed-run-performance" "$release"

cp -R "$performance" "$scratch/bad-catalog-performance"
jq '.catalog_sha256 = ("b" * 64)' \
  "$scratch/bad-catalog-performance/linux-1/qualification-receipt.json" \
  > "$scratch/bad-catalog-performance/linux-1/qualification.changed"
mv "$scratch/bad-catalog-performance/linux-1/qualification.changed" \
  "$scratch/bad-catalog-performance/linux-1/qualification-receipt.json"
expect_failure bad-catalog-performance run_gate \
  "$macos" "$bsd" "$scratch/bad-catalog-performance" "$release"

jq --arg commit "$other_commit" '.commit = $commit | .git.sha = $commit' \
  "$release" > "$scratch/wrong-release.json"
expect_failure wrong-release run_gate \
  "$macos" "$bsd" "$performance" "$scratch/wrong-release.json"

printf 'stable 1.0 evidence validator tests passed\n'
